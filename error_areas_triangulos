def calcular_area_lineal(w1, dw1, h1, dh1, w2, dw2, h2, dh2):
    
    A1 = 0.5 * w1 * h1
    A2 = 0.5 * w2 * h2
    A_tot = A1 + A2

    dA1 = 0.5 * (w1 * dh1 + h1 * dw1)
    dA2 = 0.5 * (w2 * dh2 + h2 * dw2)
    dA_tot = dA1 + dA2
    
    return A1, dA1, A2, dA2, A_tot, dA_tot

